{
  "name": "gdx-analyzer",
  "displayName": "GDX Analyzer",
  "description": "Browse, chart and compare GAMS GDX files: a fast viewer with table view, charts, gdxdiff comparisons, Excel export and MCP tools for AI agents. Independent; not affiliated with GAMS.",
  "version": "0.9.0",
  "publisher": "muhammet-soyturk",
  "author": {
    "name": "Muhammet Soyturk"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mabdullahsoyturk/GDX-Analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/mabdullahsoyturk/GDX-Analyzer/issues"
  },
  "homepage": "https://github.com/mabdullahsoyturk/GDX-Analyzer#readme",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "gams",
    "gamspy",
    "gdx",
    "gdxdump",
    "gdxdiff"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:gams",
    "onLanguage:python"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gams",
        "aliases": [
          "GAMS"
        ],
        "extensions": [
          ".gms"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "gdxAnalyzer.viewer",
        "displayName": "GDX Analyzer",
        "selector": [
          {
            "filenamePattern": "*.gdx"
          }
        ],
        "priority": "default"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "gdxAnalyzer.mcp",
        "label": "GDX"
      }
    ],
    "commands": [
      {
        "command": "gdxAnalyzer.open",
        "title": "Open in GDX Analyzer",
        "category": "GDX"
      },
      {
        "command": "gdxAnalyzer.dump",
        "title": "Dump to Text (gdxdump)",
        "category": "GDX"
      },
      {
        "command": "gdxAnalyzer.dumpSymbol",
        "title": "Dump Symbol to Text (gdxdump)",
        "category": "GDX"
      },
      {
        "command": "gdxAnalyzer.exportCsv",
        "title": "Export Symbol to CSV",
        "category": "GDX"
      },
      {
        "command": "gdxAnalyzer.selectForCompare",
        "title": "Select for GDX Compare",
        "category": "GDX"
      },
      {
        "command": "gdxAnalyzer.compareWithSelected",
        "title": "Compare with Selected GDX (gdxdiff)",
        "category": "GDX"
      },
      {
        "command": "gdxAnalyzer.compare",
        "title": "Compare GDX Files (gdxdiff)",
        "category": "GDX"
      },
      {
        "command": "gdxAnalyzer.compareScenarios",
        "title": "Compare Scenarios…",
        "category": "GDX"
      },
      {
        "command": "gdxAnalyzer.compareWithRevision",
        "title": "Compare with Git Revision… (gdxdiff)",
        "category": "GDX"
      },
      {
        "command": "gdxAnalyzer.exportExcel",
        "title": "Export to Excel…",
        "category": "GDX"
      },
      {
        "command": "gdxAnalyzer.resetViewState",
        "title": "Reset Viewer State",
        "category": "GDX"
      },
      {
        "command": "gdxAnalyzer.selectEncoding",
        "title": "Select Encoding of Labels…",
        "category": "GDX"
      },
      {
        "command": "gdxAnalyzer.copyMcpServerConfig",
        "title": "Copy MCP Server Configuration for AI Agents…",
        "category": "GDX"
      },
      {
        "command": "gdxAnalyzer.showSymbol",
        "title": "Show Symbol in GDX File",
        "category": "GDX"
      },
      {
        "command": "gdxAnalyzer.showInViewer",
        "title": "Show in GDX Analyzer",
        "category": "GDX"
      },
      {
        "command": "gdxAnalyzer.showToolInfo",
        "title": "Show Tool Information",
        "category": "GDX"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "gdxAnalyzer.open",
          "when": "resourceExtname == .gdx && !explorerResourceIsFolder",
          "group": "navigation@10"
        },
        {
          "command": "gdxAnalyzer.dump",
          "when": "resourceExtname == .gdx && !explorerResourceIsFolder",
          "group": "gdx@1"
        },
        {
          "command": "gdxAnalyzer.exportExcel",
          "when": "resourceExtname == .gdx && !explorerResourceIsFolder",
          "group": "gdx@2"
        },
        {
          "command": "gdxAnalyzer.resetViewState",
          "when": "resourceExtname == .gdx && !explorerResourceIsFolder",
          "group": "gdx@3"
        },
        {
          "command": "gdxAnalyzer.selectForCompare",
          "when": "resourceExtname == .gdx && !explorerResourceIsFolder && !listMultiSelection",
          "group": "3_compare@10"
        },
        {
          "command": "gdxAnalyzer.compareWithSelected",
          "when": "resourceExtname == .gdx && !explorerResourceIsFolder && gdxAnalyzer.hasSelectionForCompare && !listMultiSelection",
          "group": "3_compare@11"
        },
        {
          "command": "gdxAnalyzer.compare",
          "when": "resourceExtname == .gdx && !explorerResourceIsFolder && listMultiSelection",
          "group": "3_compare@12"
        },
        {
          "command": "gdxAnalyzer.compareScenarios",
          "when": "resourceExtname == .gdx && !explorerResourceIsFolder",
          "group": "3_compare@13"
        },
        {
          "command": "gdxAnalyzer.compareWithRevision",
          "when": "resourceExtname == .gdx && !explorerResourceIsFolder && !listMultiSelection && gitOpenRepositoryCount != 0",
          "group": "3_compare@14"
        }
      ],
      "editor/context": [
        {
          "command": "gdxAnalyzer.showSymbol",
          "when": "editorLangId == gams || editorLangId == python",
          "group": "navigation@90"
        }
      ],
      "editor/title": [
        {
          "command": "gdxAnalyzer.dump",
          "when": "activeCustomEditorId == gdxAnalyzer.viewer",
          "group": "navigation@1"
        },
        {
          "command": "gdxAnalyzer.compare",
          "when": "activeCustomEditorId == gdxAnalyzer.viewer",
          "group": "navigation@2"
        },
        {
          "command": "gdxAnalyzer.compareScenarios",
          "when": "activeCustomEditorId == gdxAnalyzer.viewer",
          "group": "1_gdx@1"
        },
        {
          "command": "gdxAnalyzer.compareWithRevision",
          "when": "activeCustomEditorId == gdxAnalyzer.viewer && gitOpenRepositoryCount != 0",
          "group": "1_gdx@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gdxAnalyzer.selectForCompare",
          "when": "false"
        },
        {
          "command": "gdxAnalyzer.compareWithSelected",
          "when": "false"
        },
        {
          "command": "gdxAnalyzer.showInViewer",
          "when": "false"
        },
        {
          "command": "gdxAnalyzer.compareWithRevision",
          "when": "gitOpenRepositoryCount != 0"
        },
        {
          "command": "gdxAnalyzer.showSymbol",
          "when": "editorLangId == gams || editorLangId == python"
        }
      ]
    },
    "configuration": {
      "title": "GDX Analyzer",
      "properties": {
        "gdxAnalyzer.backend": {
          "type": "string",
          "enum": [
            "auto",
            "bundled",
            "gams",
            "gamspy"
          ],
          "enumDescriptions": [
            "Use the gdxdump/gdxdiff bundled with the extension if this package has them for the platform, otherwise those of a GAMS system, otherwise the GAMSPy CLI.",
            "Always use the gdxdump/gdxdiff bundled with the extension (from the gamspy_base package of GAMS).",
            "Always use gdxdump/gdxdiff from a GAMS system directory (e.g. to use the tools of a specific GAMS version).",
            "Always use `gamspy gdx dump` / `gamspy gdx diff`."
          ],
          "default": "auto",
          "description": "Which tools to use for reading and comparing GDX files."
        },
        "gdxAnalyzer.gamsSystemDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "GAMS system directory containing gdxdump and gdxdiff. If empty, the PATH and common install locations are searched."
        },
        "gdxAnalyzer.gamspyExecutable": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to the gamspy executable. If empty, a .venv in the workspace folders and then the PATH are searched."
        },
        "gdxAnalyzer.encoding": {
          "type": "string",
          "default": "utf-8",
          "examples": [
            "utf-8",
            "windows-1252",
            "iso-8859-15",
            "windows-1250",
            "windows-1251",
            "shift_jis",
            "gbk"
          ],
          "markdownDescription": "Encoding of the labels and explanatory texts in GDX files, e.g. `utf-8`, `windows-1252` (Latin-1) or `shift_jis`. GDX files store them as bytes as written by GAMS, so files created from sources in a legacy encoding show wrong characters with `utf-8`. Applies to the viewer, the comparison view and the gdxdump output. *GDX: Select Encoding of Labels…* picks one from a list."
        },
        "gdxAnalyzer.links.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Make GDX file names in GAMS and Python source clickable (e.g. `$gdxIn data.gdx`, `execute_unload 'out.gdx', x;` or `Container(\"out.gdx\")`), and the symbols read or written by `$load`, `execute_load`, `execute_unload` etc., to open them in the GDX viewer."
        },
        "gdxAnalyzer.maxRowsPerPage": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "description": "Number of records (list view) or rows (table view) loaded at once in the GDX viewer and the comparison view; more are loaded while scrolling."
        },
        "gdxAnalyzer.maxColumnsPerPage": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "description": "Number of columns shown per page in the table view of the GDX viewer (wider tables page their columns)."
        },
        "gdxAnalyzer.numberFormat.style": {
          "type": "string",
          "enum": [
            "g",
            "f",
            "e"
          ],
          "enumDescriptions": [
            "Automatic: fixed notation for numbers of moderate size, scientific notation otherwise; the precision is the number of significant digits.",
            "Fixed notation; the precision is the number of decimals (0-14). Very large numbers use scientific notation.",
            "Scientific notation; the precision is the number of significant digits."
          ],
          "default": "g",
          "markdownDescription": "Default format of numbers in the GDX viewer and the comparison view. Each symbol's format can be changed with *Format* in the viewer."
        },
        "gdxAnalyzer.numberFormat.precision": {
          "type": "integer",
          "default": 6,
          "minimum": 0,
          "maximum": 17,
          "markdownDescription": "Default precision: significant digits (1-17) for the `g` and `e` formats, decimals (0-14) for `f`."
        },
        "gdxAnalyzer.numberFormat.fullPrecision": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show the fewest digits that reproduce the stored values exactly (`g` and `e` formats), instead of `#gdxAnalyzer.numberFormat.precision#`."
        },
        "gdxAnalyzer.numberFormat.squeezeTrailingZeros": {
          "type": "boolean",
          "default": true,
          "description": "Remove trailing zeros after the decimal point."
        },
        "gdxAnalyzer.rememberViewState": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Remember the view of each GDX file (selected symbol and, per symbol, filters, sorting, fields, layout and number format) after it is closed. A symbol's view is kept while its type and dimension stay the same. *GDX: Reset Viewer State* forgets the view of a file."
        },
        "gdxAnalyzer.squeezeDefaults": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Hide the fields of variables and equations (level, marginal, bounds, scale) that have their default value in every record. Can be changed per symbol with *Fields*."
        },
        "gdxAnalyzer.copy.decimalSeparator": {
          "type": "string",
          "enum": [
            "period",
            "system",
            "custom"
          ],
          "enumDescriptions": [
            "Always use a period (.)",
            "Use the decimal separator of the system language",
            "Use gdxAnalyzer.copy.customDecimalSeparator"
          ],
          "default": "period",
          "description": "Decimal separator of numbers copied from the GDX viewer and the comparison view (the displayed values are not affected)."
        },
        "gdxAnalyzer.copy.customDecimalSeparator": {
          "type": "string",
          "default": ",",
          "markdownDescription": "Decimal separator used when `#gdxAnalyzer.copy.decimalSeparator#` is `custom`."
        },
        "gdxAnalyzer.diff.eps": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Absolute tolerance used by gdxdiff (Eps). 0 uses the tool default."
        },
        "gdxAnalyzer.diff.relEps": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Relative tolerance used by gdxdiff (RelEps). 0 uses the tool default."
        },
        "gdxAnalyzer.diff.field": {
          "type": "string",
          "enum": [
            "All",
            "L",
            "M",
            "Lo",
            "Up",
            "Prior",
            "Scale"
          ],
          "default": "All",
          "description": "Variable/equation field compared by gdxdiff."
        },
        "gdxAnalyzer.diff.compareDomains": {
          "type": "boolean",
          "default": false,
          "description": "Let gdxdiff also compare the domains of symbols (CmpDomains)."
        },
        "gdxAnalyzer.diff.ignoreSetText": {
          "type": "boolean",
          "default": false,
          "description": "Let gdxdiff ignore the explanatory texts of set elements (SetDesc=N)."
        },
        "gdxAnalyzer.diff.compareDefaults": {
          "type": "boolean",
          "default": false,
          "description": "Let gdxdiff report default values (e.g. 0 for parameters) found in only one file as differences (CmpDefaults)."
        },
        "gdxAnalyzer.diff.ignoreOrder": {
          "type": "boolean",
          "default": false,
          "description": "Let gdxdiff ignore the UEL order of the input files (IgnoreOrder)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:unit": "npm run compile && node --test \"out/test/unit/*.test.js\"",
    "test:integration": "npm run compile && node out/test/runIntegration.js",
    "test": "npm run test:unit",
    "package": "scripts/package.sh universal",
    "package:target": "scripts/package.sh",
    "fetch-tools": "python3 scripts/fetch-gdx-tools.py"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
